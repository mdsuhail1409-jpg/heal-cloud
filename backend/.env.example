# HealCloud Environment Configuration
# Copy this file to .env for local development

# Application Information
PROJECT_NAME="HealCloud"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
API_V1_STR="/api/v1"

# Security (Generate a secure 32+ character random string for production)
SECRET_KEY="dev-insecure-secret-key-change-before-production-deployment-32ch"

# Database Configuration (PostgreSQL 16)
# For local SQLite testing without Postgres: sqlite:///./healcloud_dev.db
DATABASE_URL="postgresql+psycopg2://healcloud:healcloud@localhost:5432/healcloud_db"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# CORS Configuration (JSON array of allowed origin URLs)
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]'

# Redis & Background Worker (Phase 6+)
REDIS_URL="redis://localhost:6379/0"
